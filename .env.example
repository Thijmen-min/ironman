# Copy to .env and fill in what you need. Everything is optional.

# --- Strava (create an app at https://www.strava.com/settings/api,
#     Authorization Callback Domain = localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Training thresholds used for TSS (auto-detected from Garmin when possible)
# HW_LTHR=165          # lactate threshold heart rate (bpm)
# HW_FTP=250           # cycling functional threshold power (W)
# HW_MAX_HR=190
# HW_SLEEP_TARGET_H=8

# --- App
# HW_PORT=8765
# HW_SYNC_INTERVAL_MIN=20   # auto-sync interval while the app is open
# HW_BACKFILL_DAYS=120      # history fetched on first sync
# HW_INTRADAY_DAYS=14       # days of minute-level HR/stress/body battery kept
# GARMINTOKENS=~/.garminconnect
